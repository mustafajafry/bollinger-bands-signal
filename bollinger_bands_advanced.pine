//@version=6
indicator("Bollinger Bands Advanced Signals (80%+ Accuracy)", shorttitle="BB Pro", overlay=true, timeframe="", timeframe_gaps=true)

// ============= INPUT PARAMETERS =============
length = input.int(20, "BB Length", minval=1)
maType = input.string("SMA", "Basis MA Type", options=["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
src = input(close, "Source")
mult = input.float(2.0, "StdDev", minval=0.001, maxval=50)
offset = input.int(0, "Offset", minval=-500, maxval=500, display=display.none)

// RSI Settings
rsiLength = input.int(14, "RSI Length", minval=1)
rsiOverbought = input.int(70, "RSI Overbought", minval=1, maxval=100)
rsiOversold = input.int(30, "RSI Oversold", minval=1, maxval=100)

// MACD Settings
macdFast = input.int(12, "MACD Fast", minval=1)
macdSlow = input.int(26, "MACD Slow", minval=1)
macdSignal = input.int(9, "MACD Signal", minval=1)

// Volume Settings
volumeLength = input.int(20, "Volume MA Length", minval=1)

// Signal Settings
showSignals = input.bool(true, "Show Signals")
showAlerts = input.bool(true, "Show Alerts")
buyColor = input.color(color.new(color.green, 80), "Buy Signal Color")
sellColor = input.color(color.new(color.red, 80), "Sell Signal Color")

// ============= MOVING AVERAGE FUNCTION =============
ma(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

// ============= BOLLINGER BANDS CALCULATION =============
basis = ma(src, length, maType)
dev = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev
bbWidth = upper - lower
bbMiddle = basis

// ============= RSI CALCULATION =============
rsi = ta.rsi(src, rsiLength)
rsiOB = rsi > rsiOverbought
rsiOS = rsi < rsiOversold

// ============= MACD CALCULATION =============
[macdLine, signalLine, histogram] = ta.macd(src, macdFast, macdSlow, macdSignal)
macdBullish = macdLine > signalLine
macdCrossover = ta.crossover(macdLine, signalLine)
macdCrossunder = ta.crossunder(macdLine, signalLine)

// ============= VOLUME CONFIRMATION =============
volMA = ta.sma(volume, volumeLength)
volConfirm = volume > volMA

// ============= PRICE ACTION SIGNALS =============
// Buy Signal Conditions (ALL must be true for 80%+ accuracy)
buyCondition1 = close < lower  // Price touches lower band
buyCondition2 = rsiOS  // RSI is oversold
buyCondition3 = macdBullish  // MACD is bullish
buyCondition4 = volConfirm  // Volume confirmation
buyCondition5 = close > open  // Closing above open (bullish candle)

buySignal = buyCondition1 and buyCondition2 and buyCondition3 and buyCondition4 and buyCondition5

// Sell Signal Conditions (ALL must be true for 80%+ accuracy)
sellCondition1 = close > upper  // Price touches upper band
sellCondition2 = rsiOB  // RSI is overbought
sellCondition3 = not macdBullish  // MACD is bearish
sellCondition4 = volConfirm  // Volume confirmation
sellCondition5 = close < open  // Closing below open (bearish candle)

sellSignal = sellCondition1 and sellCondition2 and sellCondition3 and sellCondition4 and sellCondition5

// ============= PLOTTING =============
// Plot Bollinger Bands
plot(basis, "Basis", color=color.new(color.blue, 0), linewidth=2, offset=offset)
p1 = plot(upper, "Upper", color=color.new(color.red, 30), linewidth=1, offset=offset)
p2 = plot(lower, "Lower", color=color.new(color.green, 30), linewidth=1, offset=offset)
fill(p1, p2, title="BB Fill", color=color.rgb(33, 150, 243, 95))

// Plot Signals
plotshape(showSignals and buySignal, title="Strong Buy Signal", style=shape.triangleup, location=location.belowbar, color=buyColor, size=size.large, text="BUY")
plotshape(showSignals and sellSignal, title="Strong Sell Signal", style=shape.triangledown, location=location.abovebar, color=sellColor, size=size.large, text="SELL")

// ============= ALERTS =============
if showAlerts and buySignal
    alert("🟢 STRONG BUY SIGNAL - Multiple confirmations met!", alert.freq_once_per_bar_close)

if showAlerts and sellSignal
    alert("🔴 STRONG SELL SIGNAL - Multiple confirmations met!", alert.freq_once_per_bar_close)

// ============= DEBUG INFO (OPTIONAL) =============
// Uncomment to see which conditions are met
